  "events": [
    "Fatsoenlijk\\CarPlay\\Events\\CarEvent"
  ],
  "android": {
    "min_version": 29,
    "init_function": "dev.fatsoenlijk.carplay.initializeCarPlay",
    "dependencies": {
      "implementation": [
        "androidx.car.app:app:1.7.0",
        "androidx.car.app:app-projected:1.7.0"
      ]
    },
    "services": [
      {
        "name": "dev.fatsoenlijk.carplay.NativeCarAppService",
        "exported": true,
        "intent_filters": [
          {
            "action": "androidx.car.app.CarAppService",
            "category": "androidx.car.app.category.POI"
          }
        ],
        "meta_data": [
          {
            "name": "androidx.car.app.minCarApiLevel",
            "value": 1
          }
        ]
      }
    ],
    "meta_data": [
      {
        "name": "com.google.android.gms.car.application",
        "resource": "@xml/nativephp_car_app_desc"
      }
    ]
  },
  "ios": {
    "min_version": "18.0",
    "info_plist": {
      "UIApplicationSceneManifest": {
        "UIApplicationSupportsMultipleScenes": true,
        "UISceneConfigurations": {
          "CPTemplateApplicationSceneSessionRoleApplication": [
            {
              "UISceneClassName": "CPTemplateApplicationScene",
              "UISceneConfigurationName": "NativePHP CarPlay",
              "UISceneDelegateClassName": "NativeCarPlaySceneDelegate"
            }
          ]
        }
      }
    }
  },
  "assets": {
    "android": {
      "android/res/xml/nativephp_car_app_desc.xml": "res/xml/nativephp_car_app_desc.xml"
    }
  },
  "hooks": {
    "post_compile": "carplay:configure"
  }
}
